FROM ubuntu:24.04

# Suppress interactive prompts during package install
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Virtual framebuffer
    xvfb \
    # System bus (required by GTK/WebKit)
    dbus \
    dbus-x11 \
    # X11 automation
    xdotool \
    # Screenshot capture
    scrot \
    # Pixel analysis
    imagemagick \
    # GTK dark theme
    gnome-themes-extra \
    adwaita-icon-theme \
    # Tauri/WebKitGTK runtime libs
    libgtk-3-0 \
    libwebkit2gtk-4.1-0 \
    libdbus-1-3 \
    libpango-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    libglib2.0-0 \
    libayatana-appindicator3-1 \
    librsvg2-common \
    libasound2t64 \
    # Needed for scrot/X11 display info
    x11-utils \
    && rm -rf /var/lib/apt/lists/*

# Copy the pre-built Tauri binary (built with: cargo tauri build)
# Expected path after `cargo tauri build`: src-tauri/target/release/blind_browser
COPY src-tauri/target/release/blind_browser /app/blind_browser

# Copy the frontend dist (built by pnpm build before cargo tauri build)
COPY dist /app/dist

WORKDIR /app

RUN chmod +x /app/blind_browser

# Entrypoint: start Xvfb with dark GTK theme, then launch the app
RUN echo '#!/bin/bash'                              > /entrypoint.sh && \
    echo 'set -e'                                  >> /entrypoint.sh && \
    echo 'Xvfb :99 -screen 0 1280x900x24 &'       >> /entrypoint.sh && \
    echo 'sleep 1'                                 >> /entrypoint.sh && \
    echo 'export DISPLAY=:99'                      >> /entrypoint.sh && \
    echo 'export GTK_THEME=Adwaita:dark'           >> /entrypoint.sh && \
    echo 'eval $(dbus-launch --sh-syntax)'         >> /entrypoint.sh && \
    echo 'exec /app/blind_browser "$@"'            >> /entrypoint.sh && \
    chmod +x /entrypoint.sh

CMD ["/entrypoint.sh"]

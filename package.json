{
  "name": "blind-browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:ui": "node --disable-warning=ExperimentalWarning --experimental-strip-types --experimental-specifier-resolution=node --test src/**/*.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev:ocr": "tauri dev --features ocr",
    "tauri:dev:full": "tauri dev --features full"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "typescript": "5.9.3",
    "vite": "8.0.1"
  }
}
